    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
